{
  "name": "llm-provider-catalog",
  "version": "0.3.0",
  "description": "A community-maintained registry of LLM provider metadata (base URLs, protocols, model lists, usage/quota lookups) for building AI gateways and routers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIModelPlane/llm-provider-catalog.git"
  },
  "keywords": [
    "LLM",
    "AI gateway",
    "provider registry",
    "OpenAI",
    "Anthropic"
  ],
  "author": "ModelPlane.dev",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "jest",
    "test:live": "jest --testPathIgnorePatterns=/node_modules/ --roots tests/live --runInBand",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint .",
    "update-models": "bash agent/update-models.sh",
    "fetch-openrouter-models": "node agent/scripts/fetch-openrouter-models.mjs",
    "fetch-novita-models": "node agent/scripts/fetch-novita-models.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.4",
    "tsup": "^8.3.5",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.64.0"
  }
}
